<h2><%= l(:label_plugin_xlse_settings_title) %></h2>

<%= error_messages_for @query %>

<div id="settings">
  <%= form_tag({:controller => 'xls_export', :action => 'index', :project_id => params[:project_id]}, class: 'multiple-submit') do %>
    <%= query_as_hidden_field_tags(@query) %>

    <%= render :partial => 'settings/xls_export_settings', :format => [:html],
               :locals => {:settings => @settings, :export => true}%>

    <%= submit_tag l(:label_plugin_xlse_button_export), data: {disable_with: false} %>

    <%= link_to l(:label_plugin_xlse_button_back), {:controller => 'issues', :action => 'index', :project_id => @project, :query_id => params[:query_id], :sort => params[:sort] } %>
  <% end %>
</div>
